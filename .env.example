# Keine echten Geheimnisse hier. Nach .env kopieren (von Git ignoriert) und selbst exportieren;
# der Starter lädt .env nicht automatisch und braucht keinen API-Schlüssel (nur Mock-Anbieter).
YY_HOST=127.0.0.1
YY_PORT=8469
YY_DB_PATH=data/knowledge.sqlite3
YY_AUDIT_PATH=data/audit.jsonl
YY_PROVIDER=mock
YY_MAX_TASK_CHARS=2000
YY_TASK_TIMEOUT_S=10
YY_MAX_RETRIES=1
YY_SHUTDOWN_GRACE_S=5
YY_MAX_WORKERS=4
# Kommagetrennte name=https://url-Einträge für den Visionär-Wochenbericht (leer = keine)
YY_REPORT_SOURCES=
