# No real secrets here. Copy to .env (git-ignored) and export the variables yourself;
# the starter does not auto-load .env and needs no API key (mock provider only).
YY_HOST=127.0.0.1
YY_PORT=8469
YY_DB_PATH=data/knowledge.sqlite3
YY_AUDIT_PATH=data/audit.jsonl
YY_PROVIDER=mock
YY_MAX_TASK_CHARS=2000
YY_TASK_TIMEOUT_S=10
YY_MAX_RETRIES=1
YY_SHUTDOWN_GRACE_S=5
YY_MAX_WORKERS=4
# Comma-separated name=https://url entries for the Visionär weekly report (empty = none)
YY_REPORT_SOURCES=
